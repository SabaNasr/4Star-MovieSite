@model Service.Admin.Content.AboutUsTeamMember.AboutUsTeamMemberDetailsDto


<div class="card border-0 shadow-sm">

    <div class="card-header">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

            <div class="d-flex align-items-center">

                <div class="avatar me-3">
                    <span class="avatar-initial rounded bg-label-success">
                        <i class="bx bx-user fs-4"></i>
                    </span>
                </div>

                <div>

                    <h5 class="mb-1">
                        جزئیات عضو تیم
                    </h5>

                    <small class="text-muted">
                        مشاهده اطلاعات کامل عضو تیم
                    </small>

                </div>

            </div>

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">

                    <i class="bx bx-edit-alt me-1"></i>
                    ویرایش

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bx bx-arrow-back me-1"></i>
                    بازگشت

                </a>

            </div>

        </div>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-lg-4 text-center mb-4">

                <img src="@Model.ImagePath"
                     alt="@Model.FullName"
                     class="rounded-circle"
                     style="width:220px;height:220px;object-fit:cover;" />

            </div>

            <div class="col-lg-8">

                <div class="mb-4">

                    <small class="text-muted d-block mb-1">
                        نام و نام خانوادگی
                    </small>

                    <h4>
                        @Model.FullName
                    </h4>

                </div>

                <div class="mb-4">

                    <small class="text-muted d-block mb-1">
                        عنوان شغلی
                    </small>

                    <h6>
                        @Model.JobTitle
                    </h6>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <div class="border rounded-3 p-3 text-center">

                            <small class="text-muted d-block">
                                ترتیب
                            </small>

                            <h5 class="mb-0 mt-1">
                                @Model.Order
                            </h5>

                        </div>

                    </div>

                    <div class="col-md-4 mb-3">

                        <div class="border rounded-3 p-3 text-center">

                            <small class="text-muted d-block">
                                وضعیت
                            </small>

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-label-success mt-2">
                                    فعال
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary mt-2">
                                    غیرفعال
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-md-4 mb-3">

                        <div class="border rounded-3 p-3 text-center">

                            <small class="text-muted d-block">
                                شناسه
                            </small>

                            <h5 class="mb-0 mt-1">
                                @Model.Id
                            </h5>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr class="my-4" />

        <div class="row">

            <div class="col-md-6 mb-3">

                <small class="text-muted d-block mb-1">
                    تاریخ ثبت
                </small>

                <span>
                    <i class="bx bx-calendar me-1"></i>
                    @Model.CreatedAt
                    .ToLocalTime()
                    .ToString("yyyy/MM/dd HH:mm")
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <small class="text-muted d-block mb-1">
                    آخرین ویرایش
                </small>

                <span>

                    <i class="bx bx-edit me-1"></i>

                    @(Model.UpdatedAt.HasValue
                        ? Model.UpdatedAt.Value
                            .ToLocalTime()
                            .ToString("yyyy/MM/dd HH:mm")
                        : "ویرایش نشده")

                </span>

            </div>

        </div>

        <div class="mt-3">

            <a asp-area="AdminPanel"
               asp-controller="AboutUsSocialLink"
               asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bx bx-share-alt me-1"></i>
                مدیریت شبکه‌های اجتماعی

            </a>

        </div>

    </div>

</div>