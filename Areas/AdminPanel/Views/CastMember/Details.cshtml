@model Service.Admin.Movies.CastMember.CastMemberDetailsDto

@{
    ViewData["Title"] = "جزئیات شخص";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card text-center">

                <div class="card-body">

                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="@Model.PhotoPath"
                             alt="@Model.FullName"
                             class="rounded-circle mb-3"
                             style="width:180px;height:180px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-label-secondary d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:180px;height:180px;">
                            <i class="bx bx-user fs-1"></i>
                        </div>
                    }

                    <h4 class="mb-2">
                        @Model.FullName
                    </h4>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-label-success">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-label-secondary">
                            غیرفعال
                        </span>
                    }

                    <div class="mt-4">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            ویرایش شخص
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-8">

            <div class="card">

                <div class="card-header">
                    <h5 class="mb-0">
                        فیلم‌های مرتبط
                    </h5>
                </div>

                <div class="card-body">

                    @if (!Model.Movies.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            این شخص هنوز به فیلمی متصل نشده است.
                        </div>
                    }
                    else
                    {
                        <div class="list-group">

                            @foreach (var movie in Model.Movies)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">

                                    <div>
                                        <strong>
                                            @movie.MovieTitle
                                        </strong>
                                    </div>

                                    <span class="badge bg-label-primary">
                                        @GetCastTypeName(movie.CastType)
                                    </span>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@functions {

    private string GetCastTypeName(DataBase.Enum.CastType castType)
    {
        return castType switch
        {
            DataBase.Enum.CastType.Actor => "بازیگر",
            DataBase.Enum.CastType.Director => "کارگردان",
            DataBase.Enum.CastType.Writer => "نویسنده",
            DataBase.Enum.CastType.Producer => "تهیه‌کننده",
            DataBase.Enum.CastType.AssistantDirector => "دستیار کارگردان",
            _ => castType.ToString()
        };
    }
}