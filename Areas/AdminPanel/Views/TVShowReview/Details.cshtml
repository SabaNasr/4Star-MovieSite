@model Service.Admin.TVShows.TVShowReview.TVShowReviewDetailsDto

@{
    ViewData["Title"] = "جزئیات نظر تی‌وی شو";
}

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            جزئیات نظر
        </h5>

        <a asp-area="AdminPanel"
           asp-controller="TVShowReview"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bx bx-arrow-back"></i>
            بازگشت

        </a>

    </div>

    <div class="card-body">

        <div class="row mb-4">

            <div class="col-md-6">

                <label class="form-label text-muted">
                    نام ارسال‌کننده
                </label>

                <div class="fw-semibold">
                    @Model.FullName
                </div>

            </div>

            <div class="col-md-6">

                <label class="form-label text-muted">
                    تی‌وی شو
                </label>

                <div class="fw-semibold">
                    @Model.TVShowTitle
                </div>

            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-4">

                <label class="form-label text-muted">
                    امتیاز
                </label>

                <div>
                    <span class="badge bg-warning text-dark">
                        @((int)Model.StarRating)
                        <i class="bx bxs-star"></i>
                    </span>
                </div>

            </div>

            <div class="col-md-4">

                <label class="form-label text-muted">
                    وضعیت
                </label>

                <div>
                    @if (Model.IsApproved)
                    {
                        <span class="badge bg-success">
                            تایید شده
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            تایید نشده
                        </span>
                    }
                </div>

            </div>

            <div class="col-md-4">

                <label class="form-label text-muted">
                    شناسه تی‌وی شو
                </label>

                <div class="fw-semibold">
                    @Model.TVShowId
                </div>

            </div>

        </div>

        <hr />

        <div class="mb-4">

            <label class="form-label text-muted">
                متن نظر
            </label>

            <div class="border rounded p-4">
                @Model.Content
            </div>

        </div>

        <hr />

        <div class="row mb-4">

            <div class="col-md-6">

                <label class="form-label text-muted">
                    تاریخ ثبت
                </label>

                <div>
                    @Model.CreatedAt
                    .ToLocalTime()
                    .ToString("yyyy/MM/dd HH:mm")
                </div>

            </div>

            <div class="col-md-6">

                <label class="form-label text-muted">
                    آخرین ویرایش
                </label>

                <div>

                    @if (Model.UpdatedAt.HasValue)
                    {
                            @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">
                            هنوز ویرایش نشده است.
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            @if (Model.IsApproved)
            {
                <form asp-area="AdminPanel"
                      asp-controller="TVShowReview"
                      asp-action="Reject"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bx bx-x"></i>
                        لغو تایید

                    </button>

                </form>
            }
            else
            {
                <form asp-area="AdminPanel"
                      asp-controller="TVShowReview"
                      asp-action="Approve"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bx bx-check"></i>
                        تایید نظر

                    </button>

                </form>
            }

            <form asp-area="AdminPanel"
                  asp-controller="TVShowReview"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('آیا از حذف این نظر مطمئن هستید؟');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bx bx-trash"></i>
                    حذف نظر

                </button>

            </form>

        </div>

    </div>

</div>