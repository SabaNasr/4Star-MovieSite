@model List<Service.Admin.TvSeries.Series.SeriesListDto>

@{
    ViewData["Title"] = "مدیریت سریال‌ها";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">مدیریت سریال‌ها</h4>
            <p class="text-muted mb-0">
                مدیریت سریال‌های ثبت شده در سایت
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Archived"
               class="btn btn-outline-secondary">
                <i class="bx bx-archive"></i>
                آرشیو
            </a>

            <a asp-action="Deleted"
               class="btn btn-outline-danger">
                <i class="bx bx-trash"></i>
                حذف شده‌ها
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bx bx-plus"></i>
                افزودن سریال
            </a>

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="card">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>

                        <th>پوستر</th>

                        <th>عنوان</th>

                        <th>سال</th>

                        <th>فصل‌ها</th>

                        <th>مدت</th>

                        <th>IMDb</th>

                        <th>بازدید</th>

                        <th>وضعیت</th>

                        <th>عملیات</th>

                    </tr>
                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center py-5 text-muted">

                                هنوز سریالی ثبت نشده است.

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.PosterPath))
                                    {
                                        <img src="@item.PosterPath"
                                             alt="@item.Title"
                                             style="width:55px;height:75px;object-fit:cover;border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            بدون تصویر
                                        </div>
                                    }

                                </td>


                                <td>
                                    <strong>
                                        @item.Title
                                    </strong>
                                </td>


                                <td>
                                    @item.Year
                                </td>


                                <td>
                                    <span class="badge bg-label-primary">
                                        @item.SeasonCount فصل
                                    </span>
                                </td>


                                <td>
                                    @item.DurationMinutes دقیقه
                                </td>


                                <td>
                                    <span class="badge bg-label-warning">
                                        @item.ImdbRating
                                    </span>
                                </td>


                                <td>
                                    @item.ViewCount
                                </td>


                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            غیرفعال
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="d-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bx bx-show"></i>
                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bx bx-edit"></i>
                                        </a>


                                        <form asp-action="ChangeStatus"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning">

                                                @if (item.IsActive)
                                                {
                                                    <i class="bx bx-block"></i>
                                                }
                                                else
                                                {
                                                    <i class="bx bx-check"></i>
                                                }

                                            </button>

                                        </form>


                                        <form asp-action="Archive"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">

                                                <i class="bx bx-archive"></i>

                                            </button>

                                        </form>


                                        <form asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('آیا از حذف این سریال مطمئن هستید؟');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">

                                                <i class="bx bx-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>