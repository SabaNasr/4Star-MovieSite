@model List<Service.Admin.TVShows.TVShowDescription.TVShowDescriptionListDto>

@{
    ViewData["Title"] = "شرح تی‌وی شوها";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="fw-bold mb-1">
                شرح تی‌وی شوها
            </h4>

            <p class="text-muted mb-0">
                مدیریت شرح کامل تی‌وی شوها
            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bx bx-plus"></i>
            افزودن شرح

        </a>

    </div>


    <div class="card">

        <div class="card-header">

            <h5 class="mb-0">
                لیست شرح تی‌وی شوها
            </h5>

        </div>


        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">

                    هنوز برای هیچ تی‌وی شویی شرح کامل ثبت نشده است.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    تی‌وی شو
                                </th>

                                <th>
                                    وضعیت
                                </th>

                                <th>
                                    تاریخ ایجاد
                                </th>

                                <th>
                                    آخرین بروزرسانی
                                </th>

                                <th>
                                    عملیات
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var description in Model)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @description.TVShowTitle
                                        </strong>

                                    </td>


                                    <td>

                                        @if (description.IsActive)
                                        {
                                            <span class="badge bg-label-success">
                                                فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-label-secondary">
                                                غیرفعال
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @description.CreatedAt
                                        .ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")

                                    </td>


                                    <td>

                                        @if (description.UpdatedAt.HasValue)
                                        {
                                                @description.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@description.Id"
                                               class="btn btn-sm btn-outline-info">

                                                <i class="bx bx-show"></i>

                                            </a>


                                            <a asp-action="Edit"
                                               asp-route-id="@description.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bx bx-edit"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>