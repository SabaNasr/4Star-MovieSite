@model Service.Admin.TvSeries.Episodes.EpisodeDetailsDto

@{
    ViewData["Title"] = "جزئیات قسمت";
}


<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="mb-1">
                جزئیات قسمت
            </h4>

            <p class="text-muted mb-0">
                اطلاعات قسمت
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bx bx-edit"></i>
                ویرایش

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bx bx-arrow-back"></i>
                بازگشت

            </a>

        </div>

    </div>

    <div class="row">

        <div class="col-md-8">

            <div class="card mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        اطلاعات قسمت
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row mb-4">

                        <div class="col-md-6">

                            <small class="text-muted">
                                سریال
                            </small>

                            <h6 class="mt-1">
                                @Model.SeriesTitle
                            </h6>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted">
                                فصل
                            </small>

                            <h6 class="mt-1">
                                @Model.SeasonName
                            </h6>

                        </div>

                    </div>

                    <div class="row mb-4">

                        <div class="col-md-6">

                            <small class="text-muted">
                                نام قسمت
                            </small>

                            <h6 class="mt-1">
                                @Model.Name
                            </h6>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted">
                                وضعیت
                            </small>

                            <div class="mt-1">

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        غیرفعال
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <small class="text-muted">
                            لینک دانلود
                        </small>

                        <div class="mt-2">

                            <a href="@Model.DownloadLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary">

                                <i class="bx bx-download"></i>
                                مشاهده لینک دانلود

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        اطلاعات ثبت
                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <small class="text-muted">
                            تاریخ ایجاد
                        </small>

                        <div class="mt-1">

                            @Model.CreatedAt
                            .ToLocalTime()
                            .ToString("yyyy/MM/dd HH:mm")

                        </div>

                    </div>

                    <div>

                        <small class="text-muted">
                            آخرین ویرایش
                        </small>

                        <div class="mt-1">

                            @if (Model.UpdatedAt.HasValue)
                            {
                                    @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">
                                    بدون ویرایش
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

            <div class="card">

                <div class="card-body text-center">

                    <a asp-controller="Season"
                       asp-action="Details"
                       asp-route-id="@Model.SeasonId"
                       class="btn btn-primary w-100">

                        <i class="bx bx-layer"></i>
                        مشاهده فصل

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>