@model Service.Admin.TvSeries.Seasons.SeasonCreateDto

@{
    ViewData["Title"] = "افزودن فصل";
}

<!-- ==================================================
     View - Season Create
     ================================================== -->

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">افزودن فصل</h4>
            <p class="text-muted mb-0">
                افزودن فصل جدید برای یک سریال
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            <i class="bx bx-arrow-back"></i>
            بازگشت
        </a>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row">

            <div class="col-md-8">

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">اطلاعات فصل</h5>
                    </div>

                    <div class="card-body">

                        <!-- سریال -->
                        <div class="mb-3">

                            <label asp-for="SeriesId"
                                   class="form-label">
                                سریال
                            </label>

                            <select asp-for="SeriesId"
                                    class="form-select">

                                <option value="">
                                    انتخاب سریال
                                </option>

                                @foreach (var series in Model.Series)
                                {
                                    <option value="@series.Id">
                                        @series.Title
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="SeriesId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- نام فصل -->
                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                نام فصل
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="مثلاً فصل ۱" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- لینک دانلود -->
                        <div class="mb-3">

                            <label asp-for="DownloadLink"
                                   class="form-label">
                                لینک دانلود فصل
                            </label>

                            <input asp-for="DownloadLink"
                                   type="url"
                                   class="form-control"
                                   placeholder="https://example.com/download/season" />

                            <span asp-validation-for="DownloadLink"
                                  class="text-danger">
                            </span>

                            <small class="form-text text-muted">
                                این فیلد اختیاری است.
                            </small>

                        </div>

                    </div>
                </div>

            </div>

            <div class="col-md-4">

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">وضعیت</h5>
                    </div>

                    <div class="card-body">

                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                فصل فعال باشد
                            </label>

                        </div>

                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    <i class="bx bx-save"></i>
                    ذخیره فصل
                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}