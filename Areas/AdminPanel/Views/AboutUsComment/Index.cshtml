@model List<Service.Admin.Content.AboutUsComment.AboutUsCommentListDto>

<div class="card border-0 shadow-sm">

    <div class="card-header">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center">

                <div class="avatar me-3">

                    <span class="avatar-initial rounded bg-label-warning">

                        <i class="bx bx-message-rounded-detail fs-4"></i>

                    </span>

                </div>

                <div>

                    <h5 class="mb-1">
                        نظرات درباره ما
                    </h5>

                    <small class="text-muted">
                        مشاهده و مدیریت تایید نظرات کاربران
                    </small>

                </div>

            </div>

            <a asp-area="AdminPanel"
               asp-controller="AboutUs"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bx bx-arrow-back me-1"></i>
                درباره ما

            </a>

        </div>

    </div>

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <div class="avatar avatar-xl mx-auto mb-3">

                    <span class="avatar-initial rounded bg-label-warning">

                        <i class="bx bx-message-rounded-x fs-2"></i>

                    </span>

                </div>

                <h5>
                    هنوز نظری ثبت نشده است
                </h5>

                <p class="text-muted mb-0">
                    نظرات کاربران پس از ثبت در این قسمت نمایش داده می‌شوند.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                نام
                            </th>

                            <th>
                                عنوان شغلی
                            </th>

                            <th>
                                امتیاز
                            </th>

                            <th>
                                نظر
                            </th>

                            <th>
                                وضعیت
                            </th>

                            <th>
                                تاریخ ثبت
                            </th>

                            <th>
                                عملیات
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var comment in Model)
                        {
                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @comment.FullName
                                    </div>

                                </td>

                                <td>

                                    <span class="text-muted">
                                        @comment.JobTitle
                                    </span>

                                </td>

                                <td>

                                    @{
                                        var rating =
                                            (int)comment.StarRating;
                                    }

                                    <div class="text-nowrap">

                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            if (i <= rating)
                                            {
                                                <i class="bx bxs-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bx bx-star text-muted"></i>
                                            }
                                        }

                                    </div>

                                </td>

                                <td style="min-width:250px;">

                                    @{
                                        var content =
                                            comment.Content.Length > 100
                                                ? comment.Content.Substring(0, 100) + "..."
                                                : comment.Content;
                                    }

                                    @content

                                </td>

                                <td>

                                    @if (comment.IsApproved)
                                    {
                                        <span class="badge bg-label-success">

                                            <i class="bx bx-check-circle me-1"></i>
                                            تایید شده

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-warning">

                                            <i class="bx bx-time-five me-1"></i>
                                            تایید نشده

                                        </span>
                                    }

                                </td>

                                <td>

                                    <small>
                                        @comment.CreatedAt
                                        .ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")
                                    </small>

                                </td>

                                <td>

                                    <div class="d-flex gap-1 flex-wrap">

                                        <a asp-action="Details"
                                           asp-route-id="@comment.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="مشاهده">

                                            <i class="bx bx-show"></i>

                                        </a>

                                        @if (!comment.IsApproved)
                                        {
                                            <form asp-action="Approve"
                                                  asp-route-id="@comment.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="تایید">

                                                    <i class="bx bx-check"></i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Reject"
                                                  asp-route-id="@comment.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="لغو تایید">

                                                    <i class="bx bx-x"></i>

                                                </button>

                                            </form>
                                        }

                                        <form asp-action="Delete"
                                              asp-route-id="@comment.Id"
                                              method="post"
                                              onsubmit="return confirm('آیا از حذف این نظر مطمئن هستید؟');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="حذف">

                                                <i class="bx bx-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>