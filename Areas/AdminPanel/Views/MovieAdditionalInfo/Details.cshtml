@model Service.Admin.Movies.MovieAdditionalInfo.MovieAdditionalInfoDetailsDto

@{
    ViewData["Title"] = "جزئیات اطلاعات تکمیلی فیلم";
}

@section Styles
{
    <style>

        .additional-info-content {
            line-height: 2;
            direction: rtl;
            text-align: right;
        }

            .additional-info-content img {
                max-width: 100%;
                height: auto;
            }

            .additional-info-content .ql-align-center {
                text-align: center;
            }

            .additional-info-content .ql-align-right {
                text-align: right;
            }

            .additional-info-content .ql-align-justify {
                text-align: justify;
            }

    </style>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4>
                اطلاعات تکمیلی فیلم
            </h4>

            <p class="text-muted mb-0">
                @Model.MovieTitle
            </p>

        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                ویرایش
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                بازگشت
            </a>

        </div>

    </div>

    <div class="card">

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-4">

                    <strong>
                        فیلم:
                    </strong>

                    <span>
                        @Model.MovieTitle
                    </span>

                </div>

                <div class="col-md-4">

                    <strong>
                        وضعیت:
                    </strong>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            غیرفعال
                        </span>
                    }

                </div>

                <div class="col-md-4">

                    <strong>
                        تاریخ ثبت:
                    </strong>

                    <span>
                        @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    </span>

                </div>

            </div>

            <hr />

            <div class="mb-3">

                <h5>
                    اطلاعات تکمیلی
                </h5>

            </div>

            <div class="additional-info-content">

                @Html.Raw(Model.Content)

            </div>

            <hr />

            <div class="text-muted">

                <strong>
                    تاریخ ویرایش:
                </strong>

                @if (Model.UpdatedAt.HasValue)
                {
                    @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                }
                else
                {
                    <span>-</span>
                }

            </div>

        </div>

    </div>

</div>