@model List<Service.Admin.TVShows.TVShowReview.TVShowReviewListDto>

@{
    ViewData["Title"] = "نظرات تی‌وی شو";
}

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">
            مدیریت نظرات تی‌وی شو
        </h5>
    </div>

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                هنوز نظری برای تی‌وی شوها ثبت نشده است.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>نام</th>
                            <th>تی‌وی شو</th>
                            <th>نظر</th>
                            <th>امتیاز</th>
                            <th>وضعیت</th>
                            <th>تاریخ</th>
                            <th class="text-center">
                                عملیات
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.FullName
                                    </strong>
                                </td>

                                <td>
                                    @item.TVShowTitle
                                </td>

                                <td>
                                    @if (item.Content.Length > 80)
                                    {
                                        @item.Content.Substring(0, 80)
                                        <span>...</span>
                                    }
                                    else
                                    {
                                        @item.Content
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @((int)item.StarRating)
                                        <i class="bx bxs-star"></i>
                                    </span>
                                </td>

                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="badge bg-success">
                                            تایید شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            تایید نشده
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.CreatedAt
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-1">

                                        <a asp-area="AdminPanel"
                                           asp-controller="TVShowReview"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info">

                                            <i class="bx bx-show"></i>

                                        </a>

                                        @if (!item.IsApproved)
                                        {
                                            <form asp-area="AdminPanel"
                                                  asp-controller="TVShowReview"
                                                  asp-action="Approve"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success"
                                                        title="تایید">

                                                    <i class="bx bx-check"></i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="AdminPanel"
                                                  asp-controller="TVShowReview"
                                                  asp-action="Reject"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-warning"
                                                        title="لغو تایید">

                                                    <i class="bx bx-x"></i>

                                                </button>

                                            </form>
                                        }

                                        <form asp-area="AdminPanel"
                                              asp-controller="TVShowReview"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('آیا از حذف این نظر مطمئن هستید؟');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    title="حذف">

                                                <i class="bx bx-trash"></i>

                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>