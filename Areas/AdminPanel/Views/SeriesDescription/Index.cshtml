@model List<Service.Admin.TvSeries.SeriesDescription.SeriesDescriptionListDto>

@{
    ViewData["Title"] = "شرح کامل سریال‌ها";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1">شرح کامل سریال‌ها</h4>
            <p class="text-muted mb-0">
                مدیریت شرح کامل سریال‌ها
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bx bx-plus me-1"></i>
            افزودن شرح کامل
        </a>

    </div>


    <!-- ==================================================
         Messages
         ================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ==================================================
         Table
         ================================================== -->

    <div class="card">

        <div class="card-body">

            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">

                    <i class="bx bx-file-blank"
                       style="font-size: 48px;">
                    </i>

                    <h5 class="mt-3">
                        هنوز شرح کاملی برای هیچ سریالی ثبت نشده است.
                    </h5>

                    <a asp-action="Create"
                       class="btn btn-primary mt-2">
                        افزودن شرح کامل
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>سریال</th>
                                <th>وضعیت</th>
                                <th>تاریخ ایجاد</th>
                                <th>آخرین ویرایش</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                var rowNumber = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @rowNumber
                                    </td>

                                    <td>
                                        <strong>
                                            @item.SeriesTitle
                                        </strong>
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                غیرفعال
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.CreatedAt.ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>
                                        @if (item.UpdatedAt.HasValue)
                                        {
                                                @item.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info"
                                               title="جزئیات">

                                                <i class="bx bx-show"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning"
                                               title="ویرایش">

                                                <i class="bx bx-edit"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                rowNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>