@model List<MovieListDto>

@{
    ViewData["Title"] = "فیلم‌های حذف شده";
}

<div class="container-xxl flex-grow-1 container-p-y">

    
    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="fw-bold py-3 mb-0">
                فیلم‌های حذف شده
            </h4>

            <p class="text-muted mb-0">
                مدیریت و بازیابی فیلم‌های حذف شده.
            </p>

        </div>


        <a asp-area="AdminPanel"
           asp-controller="Movie"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bx bx-arrow-back"></i>

            بازگشت به فیلم‌ها

        </a>

    </div>


    <div class="card">


        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                سطل زباله فیلم‌ها
            </h5>

            <span class="badge bg-label-danger">
                @(Model?.Count ?? 0) فیلم
            </span>

        </div>


        <div class="table-responsive text-nowrap">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>پوستر</th>

                        <th>نام فیلم</th>

                        <th>سال ساخت</th>

                        <th>مدت زمان</th>

                        <th>IMDb</th>

                        <th>بازدید</th>

                        <th>عملیات</th>

                    </tr>

                </thead>


                <tbody>


                    @if (Model != null && Model.Any())
                    {

                        foreach (var movie in Model)
                        {

                            <tr>


                                <!-- پوستر -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(movie.PosterPath))
                                    {

                                        <img src="@movie.PosterPath"
                                             alt="@movie.Title"
                                             class="rounded"
                                             style="width:60px;height:80px;object-fit:cover;" />

                                    }
                                    else
                                    {

                                        <div class="avatar">

                                            <span class="avatar-initial rounded bg-label-secondary">

                                                <i class="bx bx-movie"></i>

                                            </span>

                                        </div>

                                    }

                                </td>


                                <!-- عنوان -->

                                <td>

                                    <strong>
                                        @movie.Title
                                    </strong>

                                </td>


                                <!-- سال -->

                                <td>
                                    @movie.Year
                                </td>


                                <!-- مدت -->

                                <td>
                                    @movie.DurationMinutes دقیقه
                                </td>


                                <!-- IMDb -->

                                <td>

                                    <span class="badge bg-label-warning">

                                        <i class="bx bx-star"></i>

                                        @movie.ImdbRating

                                    </span>

                                </td>


                                <!-- بازدید -->

                                <td>

                                    <span class="badge bg-label-info">

                                        <i class="bx bx-show"></i>

                                        @movie.ViewCount

                                    </span>

                                </td>


                                <!-- عملیات -->

                                <td>

                                    <div class="dropdown">

                                        <button type="button"
                                                class="btn p-0 dropdown-toggle hide-arrow"
                                                data-bs-toggle="dropdown">

                                            <i class="bx bx-dots-vertical-rounded"></i>

                                        </button>


                                        <div class="dropdown-menu">


                                            <!-- بازیابی -->

                                            <form asp-area="AdminPanel"
                                                  asp-controller="Movie"
                                                  asp-action="Restore"
                                                  asp-route-id="@movie.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item text-success">

                                                    <i class="bx bx-undo me-1"></i>

                                                    بازیابی فیلم

                                                </button>

                                            </form>


                                        </div>

                                    </div>

                                </td>

                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <i class="bx bx-trash fs-1 text-muted"></i>

                                <p class="mt-3 text-muted">
                                    هیچ فیلم حذف شده‌ای وجود ندارد.
                                </p>

                                <a asp-area="AdminPanel"
                                   asp-controller="Movie"
                                   asp-action="Index"
                                   class="btn btn-primary">

                                    بازگشت به لیست فیلم‌ها

                                </a>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>


</div>
