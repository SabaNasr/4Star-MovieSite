@model Service.Admin.Blog.BlogComment.BlogCommentDetailsDto

@{
    ViewData["Title"] = "جزئیات کامنت";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                جزئیات کامنت
            </h4>

            <p class="text-muted mb-0">
                مشاهده کامل اطلاعات کامنت
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bx bx-arrow-back me-1"></i>
            بازگشت

        </a>

    </div>

    <div class="row">

        <!-- Main Content -->
        <div class="col-md-8">

            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        متن کامنت
                    </h5>
                </div>

                <div class="card-body">

                    <div class="p-3 bg-light rounded">

                        <p class="mb-0"
                           style="white-space: pre-wrap;">
                            @Model.Content
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <!-- Information -->
        <div class="col-md-4">

            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        اطلاعات کامنت
                    </h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <small class="text-muted d-block mb-1">
                            نام ارسال‌کننده
                        </small>

                        <strong>
                            @Model.FullName
                        </strong>

                    </div>

                    <div class="mb-3">

                        <small class="text-muted d-block mb-1">
                            مقاله
                        </small>

                        <strong>
                            @Model.BlogPostTitle
                        </strong>

                    </div>

                    <div class="mb-3">

                        <small class="text-muted d-block mb-1">
                            وضعیت
                        </small>

                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-label-success">
                                تایید شده
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-label-warning">
                                تایید نشده
                            </span>
                        }

                    </div>

                    <div class="mb-3">

                        <small class="text-muted d-block mb-1">
                            تاریخ ثبت
                        </small>

                        <span>
                            @Model.CreatedAt.ToLocalTime()
                            .ToString("yyyy/MM/dd HH:mm")
                        </span>

                    </div>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="mb-3">

                            <small class="text-muted d-block mb-1">
                                آخرین بروزرسانی
                            </small>

                            <span>
                                @Model.UpdatedAt.Value
                                .ToLocalTime()
                                .ToString("yyyy/MM/dd HH:mm")
                            </span>

                        </div>
                    }

                </div>

            </div>

            <!-- Actions -->
            <div class="card">

                <div class="card-body">

                    @if (!Model.IsApproved)
                    {
                        <form asp-action="Approve"
                              method="post"
                              class="mb-2">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bx bx-check me-1"></i>
                                تایید کامنت

                            </button>

                        </form>
                    }
                    else
                    {
                        <form asp-action="Reject"
                              method="post"
                              class="mb-2">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-warning w-100">

                                <i class="bx bx-x me-1"></i>
                                لغو تایید

                            </button>

                        </form>
                    }

                    <form asp-action="Delete"
                          method="post"
                          onsubmit="return confirm('آیا از حذف این کامنت مطمئن هستید؟');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-danger w-100">

                            <i class="bx bx-trash me-1"></i>
                            حذف کامنت

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>