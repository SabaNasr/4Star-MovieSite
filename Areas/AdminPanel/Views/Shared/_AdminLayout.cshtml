<!DOCTYPE html>
<html lang="fa"
      class="light-style layout-navbar-fixed layout-menu-fixed"
      dir="rtl"
      data-theme="theme-default"
      data-assets-path="/admin/assets/"
      data-template="vertical-menu-template">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0">

    <meta name="description" content="پنل مدیریت 4Star">

    <title>پنل مدیریت 4Star</title>


    <!-- =====================================================
         Favicon
    ====================================================== -->

    <link rel="icon"
          type="image/x-icon"
          href="/admin/assets/img/favicon/favicon.ico">


    <!-- =====================================================
         Fonts
    ====================================================== -->

    <link rel="stylesheet"
          href="/admin/assets/vendor/fonts/boxicons.css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/fonts/fontawesome.css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/fonts/flag-icons.css">


    <!-- =====================================================
         Core CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="/admin/assets/vendor/css/rtl/core.css"
          class="template-customizer-core-css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/css/rtl/theme-default.css"
          class="template-customizer-theme-css">

    <link rel="stylesheet"
          href="/admin/assets/css/demo.css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/css/rtl/rtl.css">


    <!-- =====================================================
         Vendor CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="/admin/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/libs/typeahead-js/typeahead.css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/libs/apex-charts/apex-charts.css">

    <link rel="stylesheet"
          href="/admin/assets/vendor/libs/dropzone/dropzone.css">


    <!-- =====================================================
         Helpers
    ====================================================== -->

    <script src="/admin/assets/vendor/js/helpers.js"></script>

    <script src="/admin/assets/vendor/js/template-customizer.js"></script>

    <script src="/admin/assets/js/config.js"></script>


    <!-- =====================================================
         Mobile Responsive Navbar
    ====================================================== -->

    <style>

            @@media (max-width: 1199.98px) {

                .layout-navbar {
                    min-height: 62px;
                    z-index: 1080;
                }

                    .layout-navbar .layout-menu-toggle {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        width: 40px;
                        height: 40px;
                        cursor: pointer;
                    }

                        .layout-navbar .layout-menu-toggle i {
                            font-size: 24px;
                        }
            }

    </style>


    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- =====================================================
         Layout Wrapper
    ====================================================== -->

    <div class="layout-wrapper layout-content-navbar">

        <div class="layout-container">


            <!-- =================================================
                 Sidebar / Main Menu
            ================================================== -->

            <aside id="layout-menu"
                   class="layout-menu menu-vertical menu bg-menu-theme">


                <!-- =================================================
                     Brand
                ================================================== -->

                <div class="app-brand demo">

                    <a asp-area="AdminPanel"
                       asp-controller="Home"
                       asp-action="Index"
                       class="app-brand-link">

                        <span class="app-brand-logo demo">

                            <svg width="26px"
                                 height="26px"
                                 viewbox="0 0 26 26"
                                 version="1.1"
                                 xmlns="http://www.w3.org/2000/svg"
                                 xmlns:xlink="http://www.w3.org/1999/xlink">

                                <title>پنل مدیریت 4Star</title>

                                <defs>

                                    <lineargradient x1="50%"
                                                    y1="0%"
                                                    x2="50%"
                                                    y2="100%"
                                                    id="linearGradient-1">

                                        <stop stop-color="#5A8DEE"
                                              offset="0%"></stop>

                                        <stop stop-color="#699AF9"
                                              offset="100%"></stop>

                                    </lineargradient>

                                    <lineargradient x1="0%"
                                                    y1="0%"
                                                    x2="100%"
                                                    y2="100%"
                                                    id="linearGradient-2">

                                        <stop stop-color="#FDAC41"
                                              offset="0%"></stop>

                                        <stop stop-color="#E38100"
                                              offset="100%"></stop>

                                    </lineargradient>

                                </defs>

                                <g id="Pages"
                                   stroke="none"
                                   stroke-width="1"
                                   fill="none"
                                   fill-rule="evenodd">

                                    <g id="Login---V2"
                                       transform="translate(-667.000000, -290.000000)">

                                        <g id="Login"
                                           transform="translate(519.000000, 244.000000)">

                                            <g id="Logo"
                                               transform="translate(148.000000, 42.000000)">

                                                <g id="icon"
                                                   transform="translate(0.000000, 4.000000)">

                                                    <path d="M13.8863636,4.72727273 C18.9447899,4.72727273 23.0454545,8.82793741 23.0454545,13.8863636 C23.0454545,18.9447899 18.9447899,23.0454545 13.8863636,23.0454545 C8.82793741,23.0454549 4.72727273,18.9447899 4.72727273,13.8863636 C4.72727273,13.5423509 4.74623858,13.2027679 4.78318172,12.8686032 L8.54810407,12.8689442 C8.48567157,13.19852 8.45300462,13.5386269 8.45300462,13.8863636 C8.45300462,16.887125 10.8856023,19.3197227 13.8863636,19.3197227 C16.887125,19.3197227 19.3197227,16.887125 19.3197227,13.8863636 C19.3197227,10.8856023 16.887125,8.45300462 13.8863636,8.45300462 C13.5386269,8.45300462 13.19852,8.48567157 12.8689442,8.54810462 L12.8686032,4.78318172 C13.2027679,4.74623858 13.5423509,4.72727273 13.8863636,4.72727273 Z"
                                                          fill="#4880EA"></path>

                                                    <path d="M13.5909091,1.77272727 C20.4442608,1.77272727 26,7.19618701 26,13.8863636 C26,20.5765403 20.4442608,26 13.5909091,26 C6.73755742,26 1.18181818,20.5765403 1.18181818,13.8863636 C1.18181818,13.5406269 1.19665566,13.1982714 1.22574292,12.8598734 L6.30410592,12.859962 C6.25499466,13.1951893 6.22958398,13.5378796 6.22958398,13.8863636 C6.22958398,17.855112 9.52536149,21.0724191 13.5909091,21.0724191 C17.6564567,21.0724191 20.9522347,17.855112 20.9522347,13.8863636 C20.9522347,9.91761479 17.6564567,6.70030817 13.5909091,6.70030817 C13.2336969,6.70030817 12.8824272,6.72514561 12.5388136,6.77314791 L12.5392575,1.81561642 C12.8859498,1.78721495 13.2366963,1.77272727 13.5909091,1.77272727 Z"
                                                          fill="url(#linearGradient-1)"></path>

                                                    <rect id="Rectangle"
                                                          fill="url(#linearGradient-2)"
                                                          x="0"
                                                          y="0"
                                                          width="7.68181818"
                                                          height="7.68181818"></rect>

                                                </g>

                                            </g>

                                        </g>

                                    </g>

                                </g>

                            </svg>

                        </span>


                        <span class="app-brand-text demo menu-text fw-bold ms-2">
                            4Star
                        </span>

                    </a>


                    <!-- دکمه باز و بسته کردن Sidebar -->

                    <a href="javascript:void(0);"
                       class="layout-menu-toggle menu-link text-large ms-auto">

                        <i class="bx menu-toggle-icon d-none d-xl-block fs-4 align-middle"></i>

                        <i class="bx bx-x d-block d-xl-none bx-sm align-middle"></i>

                    </a>

                </div>


                <div class="menu-divider mt-0"></div>

                <div class="menu-inner-shadow"></div>


                <!-- =================================================
                     Menu Items
                ================================================== -->

                <ul class="menu-inner py-1">


                    <!-- =================================================
                         Dashboard
                    ================================================== -->

                    <li class="menu-item">

                        <a asp-area="AdminPanel"
                           asp-controller="Home"
                           asp-action="Index"
                           class="menu-link">

                            <i class="menu-icon tf-icons bx bx-home-alt"></i>

                            <div>داشبورد</div>

                        </a>

                    </li>


                    <!-- =================================================
                         مدیریت فیلم و سریال
                    ================================================== -->

                    <li class="menu-header small text-uppercase">

                        <span class="menu-header-text">
                            مدیریت فیلم و سریال
                        </span>

                    </li>


                    <!-- =================================================
                         فیلم‌ها
                    ================================================== -->

                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-movie-play"></i>

                            <div>فیلم‌ها</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- لیست فیلم‌ها -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Movie"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>لیست فیلم‌ها</div>

                                </a>

                            </li>


                            <!-- بازیگران و عوامل -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="CastMember"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>بازیگران و عوامل</div>

                                </a>

                            </li>


                            <!-- ژانرها -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Genre"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>ژانرها</div>

                                </a>

                            </li>


                            <!-- زبان‌ها -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Language"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>زبان‌ها</div>

                                </a>

                            </li>


                            <!-- نظرات فیلم -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Review"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>نظرات فیلم</div>

                                </a>

                            </li>

                        </ul>

                    </li>


                    <!-- =================================================
                         سریال‌ها
                    ================================================== -->

                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-tv"></i>

                            <div>سریال‌ها</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- لیست سریال‌ها -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Series"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>لیست سریال‌ها</div>

                                </a>

                            </li>


                            <!-- فصل‌ها -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Season"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>فصل‌ها</div>

                                </a>

                            </li>


                            <!-- قسمت‌ها -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Episode"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>قسمت‌ها</div>

                                </a>

                            </li>


                            <!-- نظرات سریال -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="SeriesReview"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>نظرات سریال</div>

                                </a>

                            </li>

                        </ul>

                    </li>


                    <!-- =================================================
                         TVShow
                    ================================================== -->

                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-tv"></i>

                            <div>تی‌وی شوها</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- لیست TVShow -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="TVShow"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>لیست تی‌وی شوها</div>

                                </a>

                            </li>


                            <!-- قسمت‌های TVShow -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="TVShowEpisode"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>قسمت‌های تی‌وی شو</div>

                                </a>

                            </li>


                            <!-- نظرات TVShow -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="TVShowReview"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>نظرات تی‌وی شو</div>

                                </a>

                            </li>


                        </ul>

                    </li>


                    <!-- =================================================
                         مدیریت سئو
                    ================================================== -->

                    <li class="menu-header small text-uppercase">

                        <span class="menu-header-text">
                            مدیریت سئو
                        </span>

                    </li>


                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-search-alt"></i>

                            <div>مدیریت سئو</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- شرح فیلم -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="MovieDescription"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>شرح فیلم</div>

                                </a>

                            </li>


                            <!-- اطلاعات تکمیلی فیلم -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="MovieAdditionalInfo"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>اطلاعات تکمیلی فیلم</div>

                                </a>

                            </li>


                            <!-- شرح سریال -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="SeriesDescription"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>شرح سریال</div>

                                </a>

                            </li>


                            <!-- اطلاعات تکمیلی سریال -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="SeriesAdditionalInfo"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>اطلاعات تکمیلی سریال</div>

                                </a>

                            </li>


                            <!-- شرح TVShow -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="TVShowDescription"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>شرح تی‌وی شو</div>

                                </a>

                            </li>


                            <!-- اطلاعات تکمیلی TVShow -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="TVShowAdditionalInfo"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>اطلاعات تکمیلی تی‌وی شو</div>

                                </a>

                            </li>


                        </ul>

                    </li>


                    <!-- =================================================
                         مدیریت وبلاگ
                    ================================================== -->

                    <li class="menu-header small text-uppercase">

                        <span class="menu-header-text">
                            مدیریت وبلاگ
                        </span>

                    </li>


                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-news"></i>

                            <div>وبلاگ</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- پست‌های وبلاگ -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="BlogPost"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>پست‌های وبلاگ</div>

                                </a>

                            </li>


                            <!-- دسته‌بندی‌های وبلاگ -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="BlogCategory"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>دسته‌بندی‌های وبلاگ</div>

                                </a>

                            </li>


                            <!-- نظرات وبلاگ -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="BlogComment"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>نظرات وبلاگ</div>

                                </a>

                            </li>

                        </ul>

                    </li>


                    <!-- =================================================
                         صفحات و محتوا
                    ================================================== -->

                    <li class="menu-header small text-uppercase">

                        <span class="menu-header-text">
                            صفحات و محتوا
                        </span>

                    </li>


                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-file"></i>

                            <div>صفحات و محتوا</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- سوالات متداول -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="FAQ"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>سوالات متداول</div>

                                </a>

                            </li>


                            <!-- درباره ما -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="AboutUs"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>درباره ما</div>

                                </a>

                            </li>


                            <!-- سیاست حفظ حریم خصوصی -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="PrivacyPolicy"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>سیاست حفظ حریم خصوصی</div>

                                </a>

                            </li>


                            <!-- تماس با ما -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="ContactUs"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>تماس با ما</div>

                                </a>

                            </li>


                            <!-- شرایط و ضوابط -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="TermsAndConditions"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>شرایط و ضوابط</div>

                                </a>

                            </li>


                        </ul>

                    </li>


                    <!-- =================================================
                         تنظیمات سایت
                    ================================================== -->

                    <li class="menu-header small text-uppercase">

                        <span class="menu-header-text">
                            تنظیمات سایت
                        </span>

                    </li>


                    <li class="menu-item">

                        <a href="javascript:void(0);"
                           class="menu-link menu-toggle">

                            <i class="menu-icon tf-icons bx bx-cog"></i>

                            <div>تنظیمات اصلی</div>

                        </a>


                        <ul class="menu-sub">


                            <!-- تنظیمات عمومی -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="SiteSettings"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>تنظیمات عمومی سایت</div>

                                </a>

                            </li>


                            <!-- لوگو -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Logo"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>مدیریت لوگو</div>

                                </a>

                            </li>


                            <!-- بنر -->

                            <li class="menu-item">

                                <a asp-area="AdminPanel"
                                   asp-controller="Banner"
                                   asp-action="Index"
                                   class="menu-link">

                                    <div>مدیریت بنرها</div>

                                </a>

                            </li>

                        </ul>

                    </li>


                    <!-- =================================================
                         راهنما
                    ================================================== -->

                    <li class="menu-divider my-3"></li>


                    <li class="menu-item">

                        <a asp-area="AdminPanel"
                           asp-controller="Home"
                           asp-action="Help"
                           class="menu-link text-primary fw-bold">

                            <i class="menu-icon tf-icons bx bx-book-open"></i>

                            <div>راهنمای استفاده از پنل</div>

                        </a>

                    </li>

                </ul>

            </aside>


            <!-- =====================================================
                 Main Page
            ====================================================== -->

            <div class="layout-page">


                <!-- =================================================
                     Mobile Navbar
                ================================================== -->

                <nav class="layout-navbar navbar navbar-expand-xl align-items-center bg-navbar-theme d-xl-none">

                    <div class="container-fluid">


                        <!-- دکمه باز کردن Sidebar -->

                        <a href="javascript:void(0);"
                           class="layout-menu-toggle navbar-nav align-items-center me-3">

                            <i class="bx bx-menu bx-sm"></i>

                        </a>


                        <!-- عنوان پنل -->

                        <div class="navbar-nav-right">

                            <span class="fw-bold">
                                پنل مدیریت 4Star
                            </span>

                        </div>

                    </div>

                </nav>


                <div class="content-wrapper">


                    <!-- =================================================
                         RenderBody
                    ================================================== -->
                    @RenderBody()


                    <!-- پس‌زمینه هنگام باز شدن Overlay -->

                    <div class="content-backdrop fade"></div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             Mobile Overlay
        ====================================================== -->

        <div class="layout-overlay layout-menu-toggle"></div>

        <div class="drag-target"></div>

    </div>


    <!-- =========================================================
         JavaScript
    ========================================================== -->

    <script src="/admin/assets/vendor/libs/jquery/jquery.js"></script>

    <script src="/admin/assets/vendor/libs/popper/popper.js"></script>

    <script src="/admin/assets/vendor/js/bootstrap.js"></script>

    <script src="/admin/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>

    <script src="/admin/assets/vendor/libs/hammer/hammer.js"></script>

    <script src="/admin/assets/vendor/libs/i18n/i18n.js"></script>

    <script src="/admin/assets/vendor/libs/typeahead-js/typeahead.js"></script>

    <script src="/admin/assets/vendor/js/menu.js"></script>

    <script src="/admin/assets/vendor/libs/apex-charts/apexcharts.js"></script>

    <script src="/admin/assets/js/main.js"></script>

    <script src="/admin/assets/vendor/libs/dropzone/dropzone.js"></script>

    <script src="/admin/assets/js/forms-file-upload.js"></script>


    <!-- =========================================================
         Scripts اختصاصی View
    ========================================================== -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>