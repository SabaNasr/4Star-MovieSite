@model Service.Admin.Content.ContactUsCard.ContactUsCardCreateDto

@{
    ViewData["Title"] = "افزودن کارت تماس با ما";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- ==================================================
         Header
    ================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="fw-bold mb-0">
            افزودن کارت تماس با ما
        </h4>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bx bx-arrow-back me-1"></i>

            بازگشت

        </a>

    </div>


    <!-- ==================================================
         Form
    ================================================== -->

    <div class="card">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- Icon -->

                    <div class="col-md-6">

                        <label asp-for="Icon"
                               class="form-label">
                            آیکون
                        </label>

                        <input asp-for="Icon"
                               class="form-control"
                               placeholder="bx bx-phone" />

                        <span asp-validation-for="Icon"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            مثال:
                            <code>bx bx-phone</code>
                        </small>

                    </div>


                    <!-- Title -->

                    <div class="col-md-6">

                        <label asp-for="Title"
                               class="form-label">
                            عنوان
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="شماره تماس" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Content -->

                    <div class="col-12">

                        <label asp-for="Content"
                               class="form-label">
                            محتوا
                        </label>

                        <textarea asp-for="Content"
                                  class="form-control"
                                  rows="4"
                                  placeholder="اطلاعات این کارت را وارد کنید...">
                        </textarea>

                        <span asp-validation-for="Content"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Display Order -->

                    <div class="col-md-6">

                        <label asp-for="DisplayOrder"
                               class="form-label">
                            ترتیب نمایش
                        </label>

                        <input asp-for="DisplayOrder"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="DisplayOrder"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Status -->

                    <div class="col-md-6">

                        <div class="form-check mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                فعال

                            </label>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        انصراف

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bx bx-save me-1"></i>

                        ثبت کارت

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}