@model Service.Admin.TVShows.TVShowEpisode.TVShowEpisodeEditDto

@{
    ViewData["Title"] = "ویرایش قسمت تی‌وی شو";
}

<!-- ==================================================
     Edit - TVShowEpisode
================================================== -->

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="fw-bold mb-1">
                ویرایش قسمت تی‌وی شو
            </h4>

            <p class="text-muted mb-0">
                @Model.TVShowTitle
            </p>

        </div>


        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            <i class="bx bx-arrow-back"></i>
            بازگشت

        </a>

    </div>


    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id" />
        <input asp-for="TVShowId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row">

            <div class="col-lg-8">

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            اطلاعات قسمت
                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="mb-3">

                            <label class="form-label">
                                تی‌وی شو
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.TVShowTitle"
                                   readonly />

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="SeasonNumber"
                                       class="form-label">
                                    شماره فصل
                                </label>

                                <input asp-for="SeasonNumber"
                                       type="number"
                                       min="1"
                                       class="form-control" />

                                <span asp-validation-for="SeasonNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="EpisodeNumber"
                                       class="form-label">
                                    شماره قسمت
                                </label>

                                <input asp-for="EpisodeNumber"
                                       type="number"
                                       min="1"
                                       class="form-control" />

                                <span asp-validation-for="EpisodeNumber"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                نام قسمت
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="DownloadLink"
                                   class="form-label">
                                لینک دانلود
                            </label>

                            <input asp-for="DownloadLink"
                                   type="url"
                                   class="form-control" />

                            <span asp-validation-for="DownloadLink"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                قسمت فعال باشد
                            </label>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-4">

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            تصویر قسمت
                        </h5>

                    </div>


                    <div class="card-body">

                        @if (!string.IsNullOrWhiteSpace(
                            Model.ExistingImagePath))
                        {
                            <div class="text-center mb-3">

                                <img src="@Model.ExistingImagePath"
                                     alt="@Model.Name"
                                     style="max-width:100%;max-height:300px;object-fit:contain;border-radius:8px;" />

                            </div>
                        }


                        <label asp-for="Image"
                               class="form-label">
                            تصویر جدید
                        </label>

                        <input asp-for="Image"
                               type="file"
                               class="form-control"
                               accept="image/*"
                               id="episodeImageInput" />

                        <span asp-validation-for="Image"
                              class="text-danger">
                        </span>


                        <div class="mt-3 text-center">

                            <img id="episodeImagePreview"
                                 src="#"
                                 alt="پیش‌نمایش"
                                 style="display:none;max-width:100%;max-height:250px;object-fit:contain;border-radius:8px;" />

                        </div>

                    </div>

                </div>


                <div class="card">

                    <div class="card-body">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bx bx-save"></i>
                            ذخیره تغییرات

                        </button>


                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary w-100 mt-2">

                            انصراف

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // ==================================================
        // Preview New Episode Image
        // ==================================================

        document
            .getElementById("episodeImageInput")
            ?.addEventListener("change", function(event) {

                const file =
                    event.target.files[0];

                const preview =
                    document.getElementById(
                        "episodeImagePreview"
                    );

                if (!file) {

                    preview.style.display =
                        "none";

                    return;
                }

                const reader =
                    new FileReader();

                reader.onload = function(e) {

                    preview.src =
                        e.target.result;

                    preview.style.display =
                        "block";
                };

                reader.readAsDataURL(file);

            });

    </script>
}