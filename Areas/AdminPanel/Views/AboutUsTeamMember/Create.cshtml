@model Service.Admin.Content.AboutUsTeamMember.AboutUsTeamMemberCreateDto


<div class="card border-0 shadow-sm">

    <div class="card-header">

        <div class="d-flex align-items-center">

            <div class="avatar me-3">
                <span class="avatar-initial rounded bg-label-success">
                    <i class="bx bx-user-plus fs-4"></i>
                </span>
            </div>

            <div>

                <h5 class="mb-1">
                    افزودن عضو تیم
                </h5>

                <small class="text-muted">
                    مشخصات عضو جدید تیم را وارد کنید.
                </small>

            </div>

        </div>

    </div>

    <div class="card-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>

            <div class="row">

                <div class="col-lg-8">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="FullName"
                                   class="form-label">
                                نام و نام خانوادگی
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="نام عضو تیم" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="JobTitle"
                                   class="form-label">
                                عنوان شغلی
                            </label>

                            <input asp-for="JobTitle"
                                   class="form-control"
                                   placeholder="مثلاً مدیر فنی" />

                            <span asp-validation-for="JobTitle"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Order"
                                   class="form-label">
                                ترتیب نمایش
                            </label>

                            <input asp-for="Order"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="Order"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="AboutUsId"
                                   class="form-label">
                                صفحه درباره ما
                            </label>

                            <input asp-for="AboutUsId"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="AboutUsId"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="card bg-light border-0 mt-2">

                        <div class="card-body">

                            <div class="form-check">

                                <input asp-for="IsActive"
                                       class="form-check-input" />

                                <label asp-for="IsActive"
                                       class="form-check-label">
                                    عضو تیم فعال باشد
                                </label>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="card bg-light border-0">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">

                                <i class="bx bx-image text-success fs-4 me-2"></i>

                                <h6 class="mb-0">
                                    تصویر عضو
                                </h6>

                            </div>

                            <input asp-for="Image"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.gif,.svg,.webp"
                                   class="form-control" />

                            <span asp-validation-for="Image"
                                  class="text-danger">
                            </span>

                            <div class="text-center mt-4">

                                <img id="imagePreview"
                                     class="rounded-circle d-none"
                                     style="width:150px;height:150px;object-fit:cover;" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bx bx-arrow-back me-1"></i>
                    بازگشت

                </a>

                <button type="submit"
                        class="btn btn-success">

                    <i class="bx bx-save me-1"></i>
                    ثبت عضو

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>

        const imageInput =
            document.querySelector('input[type="file"]');

        imageInput.addEventListener('change', function (event) {

            const file =
                event.target.files[0];

            const preview =
                document.getElementById('imagePreview');

            if (!file) {
                preview.classList.add('d-none');
                return;
            }

            preview.src =
                URL.createObjectURL(file);

            preview.classList.remove('d-none');

        });

    </script>
}