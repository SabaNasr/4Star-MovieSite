@model List<Service.Admin.Content.UserQuestion.UserQuestionListDto>

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            سوالات کاربران
        </h5>

        <a asp-area="AdminPanel"
           asp-controller="FAQ"
           asp-action="Index"
           class="btn btn-secondary">
            مدیریت سوالات متداول
        </a>

    </div>

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                هنوز سوالی از طرف کاربران ثبت نشده است.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>
                                نام و نام خانوادگی
                            </th>

                            <th>
                                ایمیل
                            </th>

                            <th>
                                سوال
                            </th>

                            <th>
                                تاریخ ثبت
                            </th>

                            <th>
                                عملیات
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var question in Model)
                        {
                            <tr>

                                <td>
                                    @question.FullName
                                </td>

                                <td>
                                    @question.Email
                                </td>

                                <td>
                                    @{
                                        var message =
                                            question.Message.Length > 100
                                                ? question.Message.Substring(0, 100) + "..."
                                                : question.Message;
                                    }

                                    @message
                                </td>

                                <td>
                                    @question.CreatedAt
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>

                                    <div class="d-flex gap-1">

                                        <a asp-area="AdminPanel"
                                           asp-controller="UserQuestion"
                                           asp-action="Details"
                                           asp-route-id="@question.Id"
                                           class="btn btn-sm btn-info">
                                            مشاهده
                                        </a>

                                        <form asp-area="AdminPanel"
                                              asp-controller="UserQuestion"
                                              asp-action="Delete"
                                              asp-route-id="@question.Id"
                                              method="post"
                                              onsubmit="return confirm('آیا از حذف این سوال مطمئن هستید؟');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                حذف
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>