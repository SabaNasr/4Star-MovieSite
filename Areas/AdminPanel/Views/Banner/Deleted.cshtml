@model List<Service.Admin.Content.Banner.BannerListDto>

@{
    ViewData["Title"] = "سطل زباله بنرها";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0">سطل زباله بنرها</h4>
        <a asp-action="Index" class="btn btn-label-secondary">
            <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
        </a>
    </div>

    <ul class="nav nav-pills mb-3">
        <li class="nav-item"><a class="nav-link" asp-action="Index"><i class="bx bx-list-ul me-1"></i> بنرهای فعال</a></li>
        <li class="nav-item"><a class="nav-link active" asp-action="Deleted"><i class="bx bx-trash me-1"></i> سطل زباله</a></li>
    </ul>

    <div class="card">
        <div class="table-responsive text-nowrap p-3">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>تصویر</th>
                        <th>متن بنر</th>
                        <th>ترتیب</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="text-muted">
                            <td>
                                <img src="@item.Image" class="rounded" width="50" height="50" style="object-fit: cover;" />
                            </td>
                            <td class="fw-bold">@item.Text</td>
                            <td>@item.Order</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-label-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-secondary">غیرفعال</span>
                                }
                            </td>
                            <td>
                                <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('آیا می‌خواهید این بنر را بازگردانی کنید؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bx bx-undo me-1"></i> بازگردانی
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="text-center p-4 text-muted">
                    <i class="bx bx-check-circle bx-md text-success"></i>
                    <p class="mt-2">سطل زباله خالی است!</p>
                </div>
            }
        </div>
    </div>
</div>