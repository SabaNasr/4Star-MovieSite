@model List<Service.Admin.TVShows.TVShowAdditionalInfo.TVShowAdditionalInfoListDto>

@{
    ViewData["Title"] = "اطلاعات تکمیلی تی‌وی شو";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">اطلاعات تکمیلی تی‌وی شو</h5>

        <a asp-area="AdminPanel"
           asp-controller="TVShowAdditionalInfo"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bx bx-plus"></i>
            افزودن اطلاعات تکمیلی
        </a>
    </div>

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">
                هنوز اطلاعات تکمیلی برای هیچ تی‌وی شویی ثبت نشده است.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>تی‌وی شو</th>
                            <th>وضعیت</th>
                            <th>تاریخ ایجاد</th>
                            <th>آخرین ویرایش</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.TVShowTitle</strong>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            غیرفعال
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>
                                    @if (item.UpdatedAt.HasValue)
                                    {
                                            @item.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">

                                        <a asp-area="AdminPanel"
                                           asp-controller="TVShowAdditionalInfo"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info">
                                            <i class="bx bx-show"></i>
                                        </a>

                                        <a asp-area="AdminPanel"
                                           asp-controller="TVShowAdditionalInfo"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning">
                                            <i class="bx bx-edit"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>