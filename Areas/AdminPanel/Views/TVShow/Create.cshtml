@model Service.Admin.TVShows.TvShow.TVShowCreateDto

@using DataBase.Enum

@{
    ViewData["Title"] = "افزودن برنامه تلویزیونی";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <form asp-area="AdminPanel"
          asp-controller="TVShow"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row">

            <!-- ==================================================
                 Main Information
            ================================================== -->

            <div class="col-lg-8">

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            اطلاعات برنامه تلویزیونی
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                عنوان
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="عنوان برنامه تلویزیونی..." />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ShortDescription"
                                   class="form-label">
                                توضیح کوتاه
                            </label>

                            <textarea asp-for="ShortDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="توضیح کوتاه برنامه...">
                            </textarea>

                            <span asp-validation-for="ShortDescription"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="DownloadLink"
                                   class="form-label">
                                لینک دانلود
                            </label>

                            <input asp-for="DownloadLink"
                                   type="url"
                                   class="form-control"
                                   placeholder="https://example.com/download/tvshow" />

                            <span asp-validation-for="DownloadLink"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                این فیلد اختیاری است.
                            </small>

                        </div>


                        <div class="row">

                            <div class="col-md-4 mb-3">

                                <label asp-for="DurationMinutes"
                                       class="form-label">
                                    مدت
                                </label>

                                <input asp-for="DurationMinutes"
                                       type="number"
                                       min="1"
                                       class="form-control" />

                                <span asp-validation-for="DurationMinutes"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="Year"
                                       class="form-label">
                                    سال
                                </label>

                                <input asp-for="Year"
                                       type="number"
                                       class="form-control" />

                                <span asp-validation-for="Year"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="ImdbRating"
                                       class="form-label">
                                    IMDb
                                </label>

                                <input asp-for="ImdbRating"
                                       type="number"
                                       step="0.1"
                                       min="0"
                                       max="10"
                                       class="form-control" />

                                <span asp-validation-for="ImdbRating"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ViewCount"
                                   class="form-label">
                                تعداد بازدید
                            </label>

                            <input asp-for="ViewCount"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="ViewCount"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     Genre
                ================================================== -->

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            ژانرها
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            @foreach (var genre in Model.Genres)
                            {
                                <div class="col-md-4 mb-2">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedGenreIds"
                                               value="@genre.Id"
                                               id="genre_@genre.Id"
                                        @(genre.IsSelected
                                            ? "checked"
                                            : "") />

                                        <label class="form-check-label"
                                               for="genre_@genre.Id">

                                            @genre.Name

                                        </label>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     Language
                ================================================== -->

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            زبان‌ها
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            @foreach (var language in Model.Languages)
                            {
                                <div class="col-md-4 mb-2">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedLanguageIds"
                                               value="@language.Id"
                                               id="language_@language.Id"
                                        @(language.IsSelected
                                            ? "checked"
                                            : "") />

                                        <label class="form-check-label"
                                               for="language_@language.Id">

                                            @language.Name

                                        </label>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     Quality
                ================================================== -->

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            کیفیت‌ها
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="row">

                            @foreach (var quality
                                     in Enum.GetValues<Quality>())
                            {
                                <div class="col-md-3 mb-2">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="AvailableQualities"
                                               value="@quality"
                                               id="quality_@quality"
                                        @(Model.AvailableQualities
                                            .Contains(quality)
                                            ? "checked"
                                            : "") />

                                        <label class="form-check-label"
                                               for="quality_@quality">

                                            @quality

                                        </label>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- ==================================================
                     Cast
                ================================================== -->

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            بازیگران و عوامل
                        </h5>

                    </div>

                    <div class="card-body">

                        @foreach (var cast
                                 in Model.CastMembers)
                        {
                            <div class="row align-items-center mb-3">

                                <div class="col-md-1">

                                    <input class="form-check-input cast-checkbox"
                                           type="checkbox"
                                           name="SelectedCastMembers"
                                           value="@cast.Id"
                                           data-cast-id="@cast.Id"
                                    @(cast.IsSelected
                                        ? "checked"
                                        : "") />

                                </div>


                                <div class="col-md-5">

                                    <div class="d-flex align-items-center">

                                        @if (!string.IsNullOrWhiteSpace(
                                            cast.PhotoPath))
                                        {
                                            <img src="@cast.PhotoPath"
                                                 style="width:45px;height:45px;object-fit:cover;"
                                                 class="rounded-circle me-2" />
                                        }

                                        <span>
                                            @cast.FullName
                                        </span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <select name="SelectedCastMembers"
                                            class="form-select cast-role-select"
                                            data-cast-id="@cast.Id"
                                            disabled="@(!cast.IsSelected)">

                                        @foreach (var castType
                                                 in Enum.GetValues<CastType>())
                                        {
                                            <option value="@castType"
                                                    selected="@(cast.CastType == castType)">
                                                @castType
                                            </option>
                                        }

                                    </select>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 Sidebar
            ================================================== -->

            <div class="col-lg-4">

                <div class="card mb-4">

                    <div class="card-header">

                        <h5 class="mb-0">
                            پوستر
                        </h5>

                    </div>

                    <div class="card-body">

                        <input asp-for="Poster"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.gif,.svg,.webp" />

                        <span asp-validation-for="Poster"
                              class="text-danger">
                        </span>

                        <div class="mt-3 text-center">

                            <img id="posterPreview"
                                 src="#"
                                 alt="Preview"
                                 class="img-fluid rounded d-none"
                                 style="max-height:400px;" />

                        </div>

                    </div>

                </div>


                <div class="card">

                    <div class="card-body">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bx bx-save me-1"></i>

                            ذخیره برنامه

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100 mt-2">

                            بازگشت

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document
            .querySelector('input[name="Poster"]')
            ?.addEventListener('change', function (event) {

                const file = event.target.files[0];

                const preview =
                    document.getElementById('posterPreview');

                if (!file) {
                    preview.classList.add('d-none');
                    return;
                }

                preview.src =
                    URL.createObjectURL(file);

                preview.classList.remove('d-none');
            });


        document
            .querySelectorAll('.cast-checkbox')
            .forEach(function (checkbox) {

                checkbox.addEventListener('change', function () {

                    const castId =
                        this.dataset.castId;

                    const select =
                        document.querySelector(
                            '.cast-role-select[data-cast-id="' +
                            castId +
                            '"]'
                        );

                    if (select) {
                        select.disabled =
                            !this.checked;
                    }

                });

            });

    </script>
}