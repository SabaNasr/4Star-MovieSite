@model List<Service.Admin.Content.AboutUsSocialLink.AboutUsSocialLinkListDto>


<div class="card border-0 shadow-sm">

    <div class="card-header">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center">

                <div class="avatar me-3">
                    <span class="avatar-initial rounded bg-label-info">
                        <i class="bx bx-share-alt fs-4"></i>
                    </span>
                </div>

                <div>

                    <h5 class="mb-1">
                        شبکه‌های اجتماعی اعضای تیم
                    </h5>

                    <small class="text-muted">
                        مدیریت آیکون و لینک شبکه‌های اجتماعی
                    </small>

                </div>

            </div>

            <div class="d-flex gap-2">

                <a asp-action="Create"
                   class="btn btn-info">

                    <i class="bx bx-plus me-1"></i>
                    افزودن لینک

                </a>

                <a asp-area="AdminPanel"
                   asp-controller="AboutUs"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bx bx-arrow-back me-1"></i>
                    درباره ما

                </a>

            </div>

        </div>

    </div>

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <div class="avatar avatar-xl mx-auto mb-3">
                    <span class="avatar-initial rounded bg-label-info">
                        <i class="bx bx-share-alt fs-2"></i>
                    </span>
                </div>

                <h5>
                    هنوز شبکه اجتماعی ثبت نشده است
                </h5>

                <p class="text-muted mb-3">
                    برای هر عضو تیم می‌توانید چند شبکه اجتماعی ثبت کنید.
                </p>

                <a asp-action="Create"
                   class="btn btn-info">

                    <i class="bx bx-plus me-1"></i>
                    افزودن شبکه اجتماعی

                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var link in Model)
                {
                    <div class="col-md-6 col-xl-4">

                        <div class="card border h-100 shadow-none">

                            <div class="card-body">

                                <div class="d-flex align-items-center mb-4">

                                    <div class="avatar me-3">

                                        <span class="avatar-initial rounded bg-label-info">
                                            <i class="@link.Icon fs-4"></i>
                                        </span>

                                    </div>

                                    <div>

                                        <h6 class="mb-1">
                                            @link.TeamMemberName
                                        </h6>

                                        <small class="text-muted">
                                            عضو تیم
                                        </small>

                                    </div>

                                </div>

                                <div class="mb-3">

                                    <small class="text-muted d-block mb-1">
                                        لینک
                                    </small>

                                    <a href="@link.Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-break">

                                        @link.Url

                                    </a>

                                </div>

                                <div class="d-flex justify-content-between align-items-center">

                                    <span class="badge bg-label-primary">
                                        ترتیب: @link.Order
                                    </span>

                                    @if (link.IsActive)
                                    {
                                        <span class="badge bg-label-success">
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-secondary">
                                            غیرفعال
                                        </span>
                                    }

                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-4">

                                    <a asp-action="Details"
                                       asp-route-id="@link.Id"
                                       class="btn btn-sm btn-outline-info">

                                        <i class="bx bx-show"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@link.Id"
                                       class="btn btn-sm btn-outline-warning">

                                        <i class="bx bx-edit"></i>

                                    </a>

                                    <form asp-action="ChangeStatus"
                                          asp-route-id="@link.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">

                                            <i class="bx bx-power-off"></i>

                                        </button>

                                    </form>

                                    <form asp-action="Delete"
                                          asp-route-id="@link.Id"
                                          method="post"
                                          onsubmit="return confirm('آیا از حذف این لینک مطمئن هستید؟');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                            <i class="bx bx-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>