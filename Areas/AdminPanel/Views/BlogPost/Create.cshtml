@model Service.Admin.Blog.BlogPost.BlogPostCreateDto

@{
    ViewData["Title"] = "افزودن پست وبلاگ";
}

@section Styles
{
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
          rel="stylesheet" />

    <style>

        #editor {
            min-height: 350px;
        }

        .ql-editor {
            min-height: 350px;
            direction: rtl;
            text-align: right;
        }

    </style>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1">
                افزودن پست وبلاگ
            </h4>

            <p class="text-muted mb-0">
                ثبت یک پست جدید برای وبلاگ
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            بازگشت
        </a>

    </div>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row">

            <div class="col-lg-8">

                <div class="card mb-4">

                    <div class="card-header">
                        اطلاعات اصلی
                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                عنوان پست
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="عنوان پست را وارد کنید" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Slug"
                                   class="form-label">
                                Slug
                            </label>

                            <input asp-for="Slug"
                                   class="form-control"
                                   placeholder="example-blog-post" />

                            <span asp-validation-for="Slug"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Slug باید یکتا باشد.
                            </small>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ShortDescription"
                                   class="form-label">
                                توضیح کوتاه
                            </label>

                            <textarea asp-for="ShortDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="توضیح کوتاه پست را وارد کنید">
                            </textarea>

                            <span asp-validation-for="ShortDescription"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                محتوای کامل
                            </label>

                            <div id="editor"></div>

                            <textarea asp-for="Content"
                                      id="Content"
                                      class="d-none">
                            </textarea>

                            <span asp-validation-for="Content"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card mb-4">

                    <div class="card-header">
                        تصویر پست
                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="Image"
                                   class="form-label">
                                تصویر
                            </label>

                            <input asp-for="Image"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.gif,.svg,.webp" />

                            <span asp-validation-for="Image"
                                  class="text-danger">
                            </span>

                        </div>

                        <img id="imagePreview"
                             src="#"
                             alt="پیش‌نمایش"
                             class="img-fluid rounded d-none" />

                    </div>

                </div>

                <div class="card mb-4">

                    <div class="card-header">
                        تنظیمات انتشار
                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="PublishDate"
                                   class="form-label">
                                تاریخ انتشار
                            </label>

                            <input asp-for="PublishDate"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="PublishDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                پست فعال / منتشر شده
                            </label>

                        </div>

                    </div>

                </div>

                <div class="card mb-4">

                    <div class="card-header">
                        دسته‌بندی‌ها
                    </div>

                    <div class="card-body">

                        @if (Model.Categories.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">
                                هنوز دسته‌بندی فعالی ثبت نشده است.
                            </div>
                        }
                        else
                        {
                            @foreach (var category in Model.Categories)
                            {
                                <div class="form-check mb-2">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedCategoryIds"
                                           value="@category.Id"
                                           id="category_@category.Id"
                                    @(category.IsSelected ? "checked" : "") />

                                    <label class="form-check-label"
                                           for="category_@category.Id">
                                        @category.Name
                                    </label>

                                </div>
                            }
                        }

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    ثبت پست
                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script>

        const quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, 4, 5, 6, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    [{ align: [] }],
                    ['link', 'image'],
                    ['blockquote'],
                    ['clean']
                ]
            },
            placeholder: 'محتوای کامل پست را وارد کنید...'
        });

        const contentInput = document.getElementById('Content');

        if (contentInput.value) {
            quill.root.innerHTML = contentInput.value;
        }

        document.querySelector('form').addEventListener('submit', function() {
            contentInput.value = quill.root.innerHTML;
        });

        const imageInput = document.getElementById('Image');
        const imagePreview = document.getElementById('imagePreview');

        imageInput.addEventListener('change', function(event) {

            const file = event.target.files[0];

            if (!file) {
                imagePreview.classList.add('d-none');
                imagePreview.src = '#';
                return;
            }

            const reader = new FileReader();

            reader.onload = function(e) {

                imagePreview.src = e.target.result;

                imagePreview.classList.remove('d-none');
            };

            reader.readAsDataURL(file);
        });

    </script>
}