@model Service.Admin.TVShows.TVShowAdditionalInfo.TVShowAdditionalInfoDetailsDto

@{
    ViewData["Title"] = "جزئیات اطلاعات تکمیلی تی‌وی شو";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            اطلاعات تکمیلی تی‌وی شو
        </h5>

        <div class="d-flex gap-2">

            <a asp-area="AdminPanel"
               asp-controller="TVShowAdditionalInfo"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="bx bx-edit"></i>
                ویرایش
            </a>

            <a asp-area="AdminPanel"
               asp-controller="TVShowAdditionalInfo"
               asp-action="Index"
               class="btn btn-secondary">
                بازگشت
            </a>

        </div>
    </div>

    <div class="card-body">

        <div class="row mb-4">

            <div class="col-md-6">
                <label class="form-label text-muted">
                    تی‌وی شو
                </label>

                <div class="fw-semibold">
                    @Model.TVShowTitle
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">
                    وضعیت
                </label>

                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            غیرفعال
                        </span>
                    }
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted">
                    شناسه
                </label>

                <div class="fw-semibold">
                    @Model.TVShowId
                </div>
            </div>

        </div>

        <hr />

        <div class="mb-4">

            <h6 class="mb-3">
                اطلاعات تکمیلی
            </h6>

            <div class="border rounded p-4">
                @Html.Raw(Model.Content)
            </div>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-6">
                <label class="form-label text-muted">
                    تاریخ ایجاد
                </label>

                <div>
                    @Model.CreatedAt
                    .ToLocalTime()
                    .ToString("yyyy/MM/dd HH:mm")
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label text-muted">
                    آخرین ویرایش
                </label>

                <div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                            @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">
                            هنوز ویرایش نشده است.
                        </span>
                    }
                </div>
            </div>

        </div>

    </div>
</div>