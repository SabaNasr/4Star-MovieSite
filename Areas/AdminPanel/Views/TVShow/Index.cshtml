@model List<Service.Admin.TVShows.TvShow.TVShowListDto>

@{
    ViewData["Title"] = "مدیریت برنامه‌های تلویزیونی";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- ==================================================
         Header
    ================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                مدیریت برنامه‌های تلویزیونی
            </h4>

            <p class="text-muted mb-0">
                مدیریت برنامه‌ها، وضعیت و اطلاعات تلویزیونی
            </p>
        </div>

        <a asp-area="AdminPanel"
           asp-controller="TVShow"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bx bx-plus me-1"></i>

            افزودن برنامه تلویزیونی

        </a>

    </div>


    <!-- ==================================================
         Messages
    ================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- ==================================================
         Table
    ================================================== -->

    <div class="card">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>پوستر</th>

                                <th>عنوان</th>

                                <th>سال</th>

                                <th>مدت</th>

                                <th>IMDb</th>

                                <th>بازدید</th>

                                <th>قسمت‌ها</th>

                                <th>وضعیت</th>

                                <th>عملیات</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var tvShow in Model)
                            {
                                <tr>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            tvShow.PosterPath))
                                        {
                                            <img src="@tvShow.PosterPath"
                                                 alt="@tvShow.Title"
                                                 style="width:60px;height:80px;object-fit:cover;"
                                                 class="rounded" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                بدون پوستر
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <strong>
                                            @tvShow.Title
                                        </strong>

                                    </td>


                                    <td>
                                        @tvShow.Year
                                    </td>


                                    <td>
                                        @tvShow.DurationMinutes دقیقه
                                    </td>


                                    <td>

                                        <span class="badge bg-label-warning">
                                            @tvShow.ImdbRating
                                        </span>

                                    </td>


                                    <td>
                                        @tvShow.ViewCount
                                    </td>


                                    <td>

                                        <span class="badge bg-label-info">
                                            @tvShow.EpisodeCount قسمت
                                        </span>

                                    </td>


                                    <td>

                                        @if (tvShow.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                غیرفعال
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-area="AdminPanel"
                                               asp-controller="TVShow"
                                               asp-action="Details"
                                               asp-route-id="@tvShow.Id"
                                               class="btn btn-sm btn-outline-info">

                                                <i class="bx bx-show"></i>

                                            </a>


                                            <a asp-area="AdminPanel"
                                               asp-controller="TVShow"
                                               asp-action="Edit"
                                               asp-route-id="@tvShow.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bx bx-edit"></i>

                                            </a>


                                            <form asp-area="AdminPanel"
                                                  asp-controller="TVShow"
                                                  asp-action="ChangeStatus"
                                                  asp-route-id="@tvShow.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning">

                                                    <i class="bx bx-power-off"></i>

                                                </button>

                                            </form>


                                            <form asp-area="AdminPanel"
                                                  asp-controller="TVShow"
                                                  asp-action="Archive"
                                                  asp-route-id="@tvShow.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">

                                                    <i class="bx bx-archive"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    هنوز برنامه تلویزیونی ثبت نشده است.
                </div>
            }

        </div>

    </div>

</div>