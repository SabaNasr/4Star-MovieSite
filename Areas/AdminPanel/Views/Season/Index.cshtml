@model List<Service.Admin.TvSeries.Seasons.SeasonListDto>

@{
    ViewData["Title"] = "مدیریت فصل‌ها";
}

<!-- ==================================================
     View - Season Index
     ================================================== -->

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">مدیریت فصل‌ها</h4>
            <p class="text-muted mb-0">
                مدیریت فصل‌های سریال‌ها
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bx bx-plus"></i>
            افزودن فصل
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>سریال</th>
                            <th>فصل</th>
                            <th>قسمت‌ها</th>
                            <th>لینک دانلود</th>
                            <th>وضعیت</th>
                            <th>تاریخ ایجاد</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-4">
                                    هنوز فصلی ثبت نشده است.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var row = 1;

                            foreach (var season in Model)
                            {
                                <tr>

                                    <td>
                                        @row
                                    </td>

                                    <td>
                                        <strong>
                                            @season.SeriesTitle
                                        </strong>
                                    </td>

                                    <td>
                                        @season.Name
                                    </td>

                                    <td>
                                        <span class="badge bg-label-info">
                                            @season.EpisodeCount قسمت
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(season.DownloadLink))
                                        {
                                            <a href="@season.DownloadLink"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                مشاهده لینک
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                ندارد
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (season.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                غیرفعال
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @season.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@season.Id"
                                               class="btn btn-sm btn-info">
                                                <i class="bx bx-show"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@season.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="bx bx-edit"></i>
                                            </a>

                                            <form asp-action="ChangeStatus"
                                                  asp-route-id="@season.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(season.IsActive ? "btn-secondary" : "btn-success")">

                                                    <i class="bx @(season.IsActive ? "bx-hide" : "bx-show")"></i>

                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>

                                row++;
                            }
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>