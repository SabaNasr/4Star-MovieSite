@model Service.Admin.Content.UserQuestion.UserQuestionDetailsDto

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            جزئیات سوال کاربر
        </h5>

        <a asp-area="AdminPanel"
           asp-controller="FAQ"
           asp-action="Index"
           class="btn btn-secondary">
            مدیریت سوالات متداول
        </a>

    </div>

    <div class="card-body">

        <div class="row mb-4">

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    نام و نام خانوادگی
                </label>

                <div class="form-control bg-light">
                    @Model.FullName
                </div>

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    ایمیل
                </label>

                <div class="form-control bg-light">
                    @Model.Email
                </div>

            </div>

        </div>

        <div class="mb-4">

            <label class="form-label fw-bold">
                متن سوال
            </label>

            <div class="border rounded p-3"
                 style="min-height: 180px; white-space: pre-line;">
                @Model.Message
            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    تاریخ ثبت
                </label>

                <div class="form-control bg-light">
                    @Model.CreatedAt
                    .ToLocalTime()
                    .ToString("yyyy/MM/dd HH:mm")
                </div>

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    آخرین ویرایش
                </label>

                <div class="form-control bg-light">
                    @(Model.UpdatedAt.HasValue
                        ? Model.UpdatedAt.Value
                            .ToLocalTime()
                            .ToString("yyyy/MM/dd HH:mm")
                        : "ویرایش نشده")
                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-area="AdminPanel"
               asp-controller="UserQuestion"
               asp-action="Index"
               class="btn btn-secondary">
                بازگشت به سوالات کاربران
            </a>

            <form asp-area="AdminPanel"
                  asp-controller="UserQuestion"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('آیا از حذف این سوال مطمئن هستید؟');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    حذف سوال
                </button>

            </form>

        </div>

    </div>

</div>