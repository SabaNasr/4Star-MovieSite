@model Service.Admin.Content.PrivacyPolicies.PrivacyPolicyDetailsDto

@{
    ViewData["Title"] = "جزئیات سیاست حفظ حریم خصوصی";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                سیاست حفظ حریم خصوصی
            </h4>

            <p class="text-muted mb-0">
                مشاهده محتوای کامل صفحه
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning me-2">
                <i class="bx bx-edit me-1"></i>
                ویرایش
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bx bx-arrow-back me-1"></i>
                بازگشت
            </a>

        </div>

    </div>

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                متن سیاست حفظ حریم خصوصی
            </h5>

            @if (Model.IsActive)
            {
                <span class="badge bg-label-success">
                    فعال
                </span>
            }
            else
            {
                <span class="badge bg-label-secondary">
                    غیرفعال
                </span>
            }

        </div>

        <div class="card-body">

            <div class="mb-4">
                @Html.Raw(Model.Content)
            </div>

            <hr />

            <div class="row">

                <div class="col-md-6">
                    <small class="text-muted">
                        تاریخ ایجاد
                    </small>

                    <div>
                        @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">
                        آخرین ویرایش
                    </small>

                    <div>
                        @(Model.UpdatedAt.HasValue
                            ? Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                            : "-")
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>