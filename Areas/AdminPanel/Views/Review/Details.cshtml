@model Service.Admin.Movies.Review.ReviewDetailsDto

@{
    ViewData["Title"] = "جزئیات نظر";
}

<div class="container-xxl flex-grow-1 container-p-y">


    <!-- ==================================================
         Header
    ================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="fw-bold py-3 mb-0">
                جزئیات نظر
            </h4>

            <p class="text-muted mb-0">
                مشاهده کامل نظر ثبت شده توسط کاربر
            </p>

        </div>


        <a asp-area="AdminPanel"
           asp-controller="Review"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bx bx-arrow-back"></i>

            بازگشت

        </a>

    </div>


    <div class="row">


        <!-- ==================================================
             اطلاعات ارسال‌کننده
        ================================================== -->

        <div class="col-lg-4">


            <div class="card mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        اطلاعات ارسال‌کننده
                    </h5>

                </div>


                <div class="card-body">


                    <div class="d-flex align-items-center gap-3">


                        <div class="avatar">

                            <span class="avatar-initial rounded-circle bg-label-primary">

                                <i class="bx bx-user"></i>

                            </span>

                        </div>


                        <div>

                            <h6 class="mb-1">
                                @Model.FullName
                            </h6>

                            <small class="text-muted">
                                ارسال‌کننده نظر
                            </small>

                        </div>


                    </div>

                </div>

            </div>


            <!-- ==================================================
                 فیلم
            ================================================== -->

            <div class="card mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        فیلم
                    </h5>

                </div>


                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">

                            @Model.MovieTitle

                        </span>


                        <a asp-area="AdminPanel"
                           asp-controller="Movie"
                           asp-action="Details"
                           asp-route-id="@Model.MovieId"
                           class="btn btn-sm btn-outline-primary">

                            مشاهده فیلم

                        </a>

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 وضعیت
            ================================================== -->

            <div class="card">

                <div class="card-header">

                    <h5 class="mb-0">
                        وضعیت نظر
                    </h5>

                </div>


                <div class="card-body">


                    @if (Model.IsApproved)
                    {
                        <div class="alert alert-success mb-3">

                            <i class="bx bx-check-circle me-1"></i>

                            این نظر تایید شده است.

                        </div>


                        <form asp-area="AdminPanel"
                              asp-controller="Review"
                              asp-action="Reject"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-warning w-100">

                                <i class="bx bx-x-circle"></i>

                                عدم تایید نظر

                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3">

                            <i class="bx bx-time me-1"></i>

                            این نظر تایید نشده است.

                        </div>


                        <form asp-area="AdminPanel"
                              asp-controller="Review"
                              asp-action="Approve"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bx bx-check-circle"></i>

                                تایید نظر

                            </button>

                        </form>
                    }


                </div>

            </div>


        </div>


        <!-- ==================================================
             متن و امتیاز
        ================================================== -->

        <div class="col-lg-8">


            <!-- ==================================================
                 امتیاز
            ================================================== -->

            <div class="card mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        امتیاز ثبت شده
                    </h5>

                </div>


                <div class="card-body">


                    <div class="d-flex align-items-center gap-3">


                        <div class="text-warning fs-3">

                            @for (var i = 1; i <= 5; i++)
                            {
                                if (i <= (int)Model.StarRating)
                                {
                                    <i class="bx bxs-star"></i>
                                }
                                else
                                {
                                    <i class="bx bx-star"></i>
                                }
                            }

                        </div>


                        <div>

                            <strong class="fs-4">

                                @((int)Model.StarRating)

                            </strong>

                            <span class="text-muted">
                                از ۵
                            </span>

                        </div>


                    </div>

                </div>

            </div>


            <!-- ==================================================
                 متن نظر
            ================================================== -->

            <div class="card mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        متن نظر
                    </h5>

                </div>


                <div class="card-body">


                    <div class="border rounded p-4"
                         style="line-height:2; white-space:pre-wrap;">

                        @Model.Content

                    </div>


                </div>

            </div>


            <!-- ==================================================
                 اطلاعات ثبت
            ================================================== -->

            <div class="card">

                <div class="card-header">

                    <h5 class="mb-0">
                        اطلاعات ثبت نظر
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row">


                        <!-- تاریخ ایجاد -->

                        <div class="col-md-6 mb-3">

                            <small class="text-muted d-block mb-1">

                                تاریخ ثبت

                            </small>

                            <strong>

                                @Model.CreatedAt
                                .ToLocalTime()
                                .ToString("yyyy/MM/dd HH:mm")

                            </strong>

                        </div>


                        <!-- آخرین بروزرسانی -->

                        <div class="col-md-6 mb-3">

                            <small class="text-muted d-block mb-1">

                                آخرین بروزرسانی

                            </small>


                            @if (Model.UpdatedAt.HasValue)
                            {
                                <strong>

                                    @Model.UpdatedAt.Value
                                    .ToLocalTime()
                                    .ToString("yyyy/MM/dd HH:mm")

                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">

                                    بروزرسانی نشده است.

                                </span>
                            }

                        </div>


                    </div>

                </div>

            </div>


            <!-- ==================================================
                 حذف
            ================================================== -->

            <div class="card mt-4">

                <div class="card-body">


                    <form asp-area="AdminPanel"
                          asp-controller="Review"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('آیا از حذف این نظر مطمئن هستید؟');">

                        @Html.AntiForgeryToken()


                        <button type="submit"
                                class="btn btn-outline-danger">

                            <i class="bx bx-trash"></i>

                            حذف نظر

                        </button>

                    </form>


                </div>

            </div>


        </div>

    </div>

</div>