@model List<Service.Admin.Content.AboutUs.AboutUsListDto>


<div class="row">

    @if (Model.Count == 0)
    {
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center py-5">

                    <div class="avatar avatar-xl mx-auto mb-3">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="bx bx-info-circle fs-2"></i>
                        </span>
                    </div>

                    <h4 class="mb-2">
                        صفحه درباره ما هنوز ایجاد نشده است
                    </h4>

                    <p class="text-muted mb-4">
                        اطلاعات اصلی صفحه درباره ما را ثبت کنید.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i>
                        ایجاد صفحه درباره ما
                    </a>

                </div>

            </div>

        </div>
    }
    else
    {
        @foreach (var aboutUs in Model)
        {
            <div class="col-12">

                <!-- Header -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body">

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                            <div class="d-flex align-items-center">

                                <div class="avatar avatar-lg me-3">
                                    <span class="avatar-initial rounded bg-label-primary">
                                        <i class="bx bx-info-circle fs-3"></i>
                                    </span>
                                </div>

                                <div>
                                    <h4 class="mb-1">
                                        درباره ما
                                    </h4>

                                    <small class="text-muted">
                                        مدیریت محتوای صفحه درباره ما
                                    </small>
                                </div>

                            </div>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@aboutUs.Id"
                                   class="btn btn-outline-info">

                                    <i class="bx bx-show me-1"></i>
                                    مشاهده

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@aboutUs.Id"
                                   class="btn btn-primary">

                                    <i class="bx bx-edit-alt me-1"></i>
                                    ویرایش

                                </a>

                                <form asp-action="ChangeStatus"
                                      asp-route-id="@aboutUs.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-secondary">

                                        <i class="bx bx-power-off me-1"></i>

                                        @(aboutUs.IsActive
                                            ? "غیرفعال کردن"
                                            : "فعال کردن")

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Main Information -->
                <div class="row">

                    <div class="col-lg-5 mb-4">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <h5 class="mb-0">
                                        تصویر صفحه
                                    </h5>

                                    <i class="bx bx-image text-primary fs-4"></i>

                                </div>

                                <div class="text-center">

                                    <img src="@aboutUs.ImagePath"
                                         alt="درباره ما"
                                         class="img-fluid rounded-3"
                                         style="width:100%; max-height:320px; object-fit:cover;" />

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-lg-7 mb-4">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <h5 class="mb-0">
                                        آمار صفحه
                                    </h5>

                                    <i class="bx bx-bar-chart-alt-2 text-primary fs-4"></i>

                                </div>

                                <div class="row g-3">

                                    <div class="col-sm-6">

                                        <div class="d-flex align-items-center p-3 rounded bg-label-primary">

                                            <div class="avatar me-3">
                                                <span class="avatar-initial rounded bg-primary">
                                                    <i class="bx bx-user"></i>
                                                </span>
                                            </div>

                                            <div>
                                                <small class="text-muted d-block">
                                                    مشتریان
                                                </small>

                                                <h5 class="mb-0">
                                                    @aboutUs.CustomerCount
                                                </h5>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-sm-6">

                                        <div class="d-flex align-items-center p-3 rounded bg-label-success">

                                            <div class="avatar me-3">
                                                <span class="avatar-initial rounded bg-success">
                                                    <i class="bx bx-user-check"></i>
                                                </span>
                                            </div>

                                            <div>
                                                <small class="text-muted d-block">
                                                    کاربران فعال
                                                </small>

                                                <h5 class="mb-0">
                                                    @aboutUs.ActiveUserCount
                                                </h5>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="border rounded-3 p-3 text-center">

                                            <i class="bx bx-video text-primary fs-3 mb-2"></i>

                                            <small class="text-muted d-block">
                                                کل ویدیوها
                                            </small>

                                            <h5 class="mb-0 mt-1">
                                                @aboutUs.TotalVideoCount
                                            </h5>

                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="border rounded-3 p-3 text-center">

                                            <i class="bx bx-group text-info fs-3 mb-2"></i>

                                            <small class="text-muted d-block">
                                                مشترکین
                                            </small>

                                            <h5 class="mb-0 mt-1">
                                                @aboutUs.SubscriberCount
                                            </h5>

                                        </div>

                                    </div>

                                    <div class="col-sm-4">

                                        <div class="border rounded-3 p-3 text-center">

                                            <i class="bx bx-trophy text-warning fs-3 mb-2"></i>

                                            <small class="text-muted d-block">
                                                جوایز
                                            </small>

                                            <h5 class="mb-0 mt-1">
                                                @aboutUs.AwardCount
                                            </h5>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Management Cards -->
                <div class="row">

                    <div class="col-md-4 mb-4">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="avatar avatar-md mb-3">
                                    <span class="avatar-initial rounded bg-label-warning">
                                        <i class="bx bx-message-rounded-detail fs-4"></i>
                                    </span>
                                </div>

                                <h5>
                                    نظرات کاربران
                                </h5>

                                <p class="text-muted mb-4">
                                    مدیریت نظرات و تایید یا لغو تایید نظرات ثبت شده.
                                </p>

                                <a asp-area="AdminPanel"
                                   asp-controller="AboutUsComment"
                                   asp-action="Index"
                                   class="btn btn-warning">

                                    <i class="bx bx-message-square-dots me-1"></i>
                                    مدیریت نظرات

                                </a>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4 mb-4">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="avatar avatar-md mb-3">
                                    <span class="avatar-initial rounded bg-label-success">
                                        <i class="bx bx-group fs-4"></i>
                                    </span>
                                </div>

                                <h5>
                                    اعضای تیم
                                </h5>

                                <p class="text-muted mb-4">
                                    اعضای تیم، تصویر، عنوان شغلی و ترتیب نمایش را مدیریت کنید.
                                </p>

                                <a asp-area="AdminPanel"
                                   asp-controller="AboutUsTeamMember"
                                   asp-action="Index"
                                   class="btn btn-success">

                                    <i class="bx bx-group me-1"></i>
                                    مدیریت اعضای تیم

                                </a>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4 mb-4">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="avatar avatar-md mb-3">
                                    <span class="avatar-initial rounded bg-label-info">
                                        <i class="bx bx-share-alt fs-4"></i>
                                    </span>
                                </div>

                                <h5>
                                    شبکه‌های اجتماعی
                                </h5>

                                <p class="text-muted mb-4">
                                    لینک و آیکون شبکه‌های اجتماعی اعضای تیم را مدیریت کنید.
                                </p>

                                <a asp-area="AdminPanel"
                                   asp-controller="AboutUsSocialLink"
                                   asp-action="Index"
                                   class="btn btn-info">

                                    <i class="bx bx-share-alt me-1"></i>
                                    مدیریت شبکه‌ها

                                </a>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Footer Info -->
                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-6 mb-3 mb-md-0">

                                <div class="d-flex align-items-center">

                                    <i class="bx bx-calendar text-primary fs-4 me-2"></i>

                                    <div>
                                        <small class="text-muted d-block">
                                            تاریخ ایجاد
                                        </small>

                                        <span>
                                            @aboutUs.CreatedAt
                                                .ToLocalTime()
                                                .ToString("yyyy/MM/dd HH:mm")
                                        </span>
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="d-flex align-items-center">

                                    <i class="bx bx-edit text-primary fs-4 me-2"></i>

                                    <div>

                                        <small class="text-muted d-block">
                                            آخرین ویرایش
                                        </small>

                                        <span>

                                            @(aboutUs.UpdatedAt.HasValue
                                                ? aboutUs.UpdatedAt.Value
                                                    .ToLocalTime()
                                                    .ToString("yyyy/MM/dd HH:mm")
                                                : "ویرایش نشده")

                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>